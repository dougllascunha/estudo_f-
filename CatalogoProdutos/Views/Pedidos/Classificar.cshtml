@model Pedido
@{
    ViewData["Title"] = "Exercício 1 — Pedidos";
}

<h1>Exercício 1 — Classificador de Pedidos</h1>

<div class="card">
    <h3>Pedido de exemplo (gerado no Controller)</h3>
    <p><strong>Valor:</strong> R$ @Model.Valor.ToString("N2")</p>
    <p><strong>Prioritário:</strong> @(Model.Prioritario ? "Sim" : "Não")</p>
    <p><strong>Itens:</strong> @string.Join(", ", Model.Itens)</p>
    <p><strong>Resultado da classificação:</strong> <span class="badge">@ViewBag.Resultado</span></p>
</div>

<div class="card">
    <h3>Testar com outros valores</h3>
    <form id="form-classificar">
        <p>
            Valor: <input type="number" step="0.01" name="valor" value="1200" />
            Prioritário: <input type="checkbox" name="prioritario" value="true" />
        </p>
        <p>
            Itens (separados por vírgula): <input type="text" name="itens" value="Mouse, Teclado, Monitor" style="width: 320px" />
        </p>
        <button type="submit">Classificar</button>
    </form>
    <p id="resultado-ajax"></p>
</div>

@section Scripts {
    <script>
        document.getElementById('form-classificar').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = new FormData(e.target);
            const params = new URLSearchParams();
            params.append('valor', form.get('valor'));
            params.append('prioritario', form.get('prioritario') === 'true');
            params.append('itens', form.get('itens'));

            const resp = await fetch('/Pedidos/ClassificarAjax', { method: 'POST', body: params });
            const data = await resp.json();
            document.getElementById('resultado-ajax').innerText = 'Resultado: ' + data.resultado;
        });
    </script>
}
